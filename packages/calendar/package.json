{
  "name": "@kreozalabs/kei-calendar",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "main": "./dist/core/index.cjs",
  "module": "./dist/core/index.js",
  "types": "./dist/core/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js",
      "require": "./dist/core/index.cjs"
    },
    "./plugins/recurrence": {
      "types": "./dist/plugins/recurrence/src/index.d.ts",
      "import": "./dist/plugins/recurrence/src/index.js",
      "require": "./dist/plugins/recurrence/src/index.cjs"
    },
    "./plugins/agenda": {
      "types": "./dist/plugins/agenda/src/index.d.ts",
      "import": "./dist/plugins/agenda/src/index.js",
      "require": "./dist/plugins/agenda/src/index.cjs"
    },
    "./plugins/drag-to-create": {
      "types": "./dist/plugins/drag-to-create/src/index.d.ts",
      "import": "./dist/plugins/drag-to-create/src/index.js",
      "require": "./dist/plugins/drag-to-create/src/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "pnpm typecheck && eslint \"src/**/*.ts*\"",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.18",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-toggle-group": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.475.0",
    "motion": "^12.36.0",
    "rrule": "^2.8.1",
    "tailwind-merge": "^3.5.0",
    "dayjs": "^1.11.20"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsup": "^8.0.2",
    "typescript": "~5.9.3"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0"
  }
}
