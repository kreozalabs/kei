{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "baseUrl": ".",
    "declaration": true,
    "outDir": "./dist",
    "paths": {
      "@/*": ["./src/*", "./src/core/*"],
      "@ilamy/calendar": ["./src/core/index.ts"],
      "@ilamy/calendar/*": ["./src/core/*"]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules"]
}
