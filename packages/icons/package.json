{
  "name": "@kreozalabs/kei-icons",
  "version": "2.0.0",
  "type": "module",
  "private": true,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "publishConfig": {
    "access": "private"
  },
  "scripts": {
    "prebuild": "node scripts/generate-components.js",
    "build": "tsup",
    "dev": "node scripts/generate-components.js && tsup --watch",
    "lint": "pnpm typecheck && eslint \"src/**/*.ts*\"",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "typecheck": "tsc -b"
  },
  "devDependencies": {
    "@svgr/core": "^8.1.0",
    "@svgr/plugin-jsx": "^8.1.0",
    "@svgr/plugin-svgo": "^8.1.0",
    "@types/react": "^19.0.0",
    "tsup": "^8.0.2",
    "typescript": "~5.9.3",
    "prettier": "^3.2.5"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  }
}
