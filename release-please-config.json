{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "node",
      "component": "kei",
      "changelog-path": "CHANGELOG.md"
    },
    "apps/web": {
      "release-type": "node",
      "component": "@kreozalabs/kei-web",
      "changelog-path": "CHANGELOG.md"
    },
    "packages/ui": {
      "release-type": "node",
      "component": "@kreozalabs/kei-ui",
      "changelog-path": "CHANGELOG.md"
    },
    "packages/icons": {
      "release-type": "node",
      "component": "@kreozalabs/kei-icons",
      "changelog-path": "CHANGELOG.md"
    }
  },
  "plugins": [
    {
      "type": "linked-versions",
      "groupName": "kei-workspace",
      "components": [
        "kei",
        "@kreozalabs/kei-web",
        "@kreozalabs/kei-ui",
        "@kreozalabs/kei-core",
        "@kreozalabs/kei-icons"
      ]
    }
  ]
}
